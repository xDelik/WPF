<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WPF.ViewModels"
             x:Class="WPF.Views.RoomsView"
             x:DataType="vm:RoomsViewModel">

    <Design.DataContext>
        <vm:RoomsViewModel/>
    </Design.DataContext>

    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="Rooms" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextHighBrush}" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="16,0" MaxWidth="280" HorizontalAlignment="Stretch">
                    <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconSearch}" Width="14" Height="14"
                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Search number…" HorizontalAlignment="Stretch"/>
                </Grid>
                <Button Grid.Column="2" Content="+ Add" Command="{Binding OpenAddDrawerCommand}"
                        Classes="accent"/>
            </Grid>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                <Path Classes="icon" Data="{StaticResource IconListFilter}" Width="14" Height="14"
                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                <RadioButton GroupName="StatusFilter" Classes="chip" Content="All" IsChecked="True"
                             Click="OnFilterAll"/>
                <RadioButton GroupName="StatusFilter" Classes="chip" Content="Available" Click="OnFilterAvailable"/>
                <RadioButton GroupName="StatusFilter" Classes="chip" Content="Occupied" Click="OnFilterOccupied"/>
                <RadioButton GroupName="StatusFilter" Classes="chip" Content="Needs cleaning" Click="OnFilterNeedsCleaning"/>
            </StackPanel>

            <Panel>
                <DataGrid ItemsSource="{Binding FilteredRooms}"
                          SelectedItem="{Binding SelectedRoom}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="100"
                                            SortMemberPath="Number"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"
                                            SortMemberPath="Type"/>
                        <DataGridTextColumn Header="Floor" Binding="{Binding Floor}" Width="70"
                                            SortMemberPath="Floor"/>
                        <DataGridTextColumn Header="Price/Night"
                                            Binding="{Binding PricePerNight, StringFormat={}{0:F2}}"
                                            Width="120"
                                            SortMemberPath="PricePerNight"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"
                                            SortMemberPath="Status"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock IsVisible="{Binding IsListEmpty}"
                           Text="No rooms match your filters."
                           Foreground="{DynamicResource TextLowBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>
        </DockPanel>

        <Border IsVisible="{Binding IsDrawerOpen}"
                HorizontalAlignment="Right"
                Width="420"
                Background="{DynamicResource CanvasBrush}"
                CornerRadius="10"
                BoxShadow="-8 0 24 0 #80000000">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Border.Transitions>
            <DockPanel Margin="16">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="Room details" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHighBrush}"/>
                    <Button Grid.Column="1" Command="{Binding CloseDrawerCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextLowBrush}">
                        <Path Classes="icon" Data="{StaticResource IconCircleX}" Width="16" Height="16"
                              Stroke="{DynamicResource TextLowBrush}"/>
                    </Button>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="8" Margin="0,16,0,0">
                    <Button Content="Add" Command="{Binding AddRoomCommand}" Classes="accent"
                            IsVisible="{Binding IsAddMode}"/>
                    <Button Content="Delete" Command="{Binding DeleteRoomCommand}"
                            IsVisible="{Binding IsEditMode}"/>
                    <Button Content="Save" Command="{Binding SaveRoomCommand}" Classes="accent"
                            IsVisible="{Binding IsEditMode}"/>
                </StackPanel>

                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="4"
                        Padding="8,6" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C" TextWrapping="Wrap"/>
                </Border>

                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Room Number"/>
                            <TextBox Text="{Binding RoomNumber}" Watermark="e.g. 101"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Type"/>
                            <ComboBox ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding RoomType}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Floor"/>
                            <NumericUpDown Value="{Binding RoomFloor}" Minimum="0" Maximum="50" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Price per Night"/>
                            <NumericUpDown Value="{Binding RoomPrice}" Minimum="0" Maximum="10000"
                                           FormatString="F2" Increment="10"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Status"/>
                            <ComboBox ItemsSource="{Binding RoomStatuses}" SelectedItem="{Binding RoomStatus}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
