<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WPF.ViewModels"
             xmlns:controls="using:WPF.Controls"
             x:Class="WPF.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Dashboard" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextHighBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding TodayLabel}"
                       Foreground="{DynamicResource TextLowBrush}" VerticalAlignment="Center"/>
        </Grid>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="OCCUPANCY" FontSize="10" Foreground="{DynamicResource TextLowBrush}"/>
                <TextBlock Text="{Binding OccupancyText}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextHighBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="ARRIVALS TODAY" FontSize="10" Foreground="{DynamicResource TextLowBrush}"/>
                <TextBlock Text="{Binding ArrivalsToday}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="AVAILABLE" FontSize="10" Foreground="{DynamicResource TextLowBrush}"/>
                <TextBlock FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextHighBrush}">
                    <Run Text="{Binding AvailableCount}"/><Run Text=" / "/><Run Text="{Binding RoomsTotal}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="2">
                <TextBlock Text="GUESTS" FontSize="10" Foreground="{DynamicResource TextLowBrush}"/>
                <TextBlock Text="{Binding GuestsCount}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextHighBrush}"/>
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Recent reservations" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextHighBrush}" Margin="0,8,0,6"/>

        <ItemsControl ItemsSource="{Binding RecentReservations}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,80,140,100" Margin="0,0,0,1" Height="28" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="{Binding Guest.FullName}"
                                   Foreground="{DynamicResource TextHighBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Room.Number}"
                                   Foreground="{DynamicResource TextMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Foreground="{DynamicResource TextLowBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding CheckInDate, StringFormat={}{0:dd MMM}}"/>
                            <Run Text=" → "/>
                            <Run Text="{Binding CheckOutDate, StringFormat={}{0:dd MMM}}"/>
                        </TextBlock>
                        <controls:StatusBadge Grid.Column="3"
                                              Label="{Binding Status}"
                                              DotBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
