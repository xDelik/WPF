<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WPF.ViewModels"
             x:Class="WPF.Views.GuestsView"
             x:DataType="vm:GuestsViewModel">

    <Design.DataContext>
        <vm:GuestsViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="*,Auto,*">

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="Guests" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding Guests}"
                      SelectedItem="{Binding SelectedGuest}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="100"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="100"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Document" Binding="{Binding DocumentNumber}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>

        <Border Grid.Column="2" Margin="8,0,0,0" Padding="16" CornerRadius="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Guest Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                    <Button Content="Clear" Command="{Binding ClearCommand}"/>
                    <Button Content="Add New" Command="{Binding AddGuestCommand}" Classes="accent"/>
                    <Button Content="Save" Command="{Binding SaveGuestCommand}"/>
                    <Button Content="Delete" Command="{Binding DeleteGuestCommand}"/>
                </StackPanel>

                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="First Name"/>
                            <TextBox Text="{Binding GuestFirstName}" Watermark="Jan"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Last Name"/>
                            <TextBox Text="{Binding GuestLastName}" Watermark="Kowalski"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Phone"/>
                            <TextBox Text="{Binding GuestPhone}" Watermark="+48 600 100 200"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Email"/>
                            <TextBox Text="{Binding GuestEmail}" Watermark="email@example.com"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Document Number"/>
                            <TextBox Text="{Binding GuestDocumentNumber}" Watermark="ABC123456"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
