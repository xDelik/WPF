<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WPF.ViewModels"
             x:Class="WPF.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">
    <Design.DataContext>
        <vm:CalendarViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}"/>
        </Style>
        <Style Selector="Border.bar:pointerover">
            <Setter Property="Background" Value="{DynamicResource SelectedNavHoverBrush}"/>
        </Style>
        <Style Selector="Border.cell">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.cell:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowLiftBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="{Binding WindowLabel}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextHighBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Command="{Binding PrevCommand}" MinWidth="48" Height="32"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="14" Height="14"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Content="Today" Command="{Binding TodayCommand}" Height="32"
                        VerticalContentAlignment="Center"/>
                <Button Command="{Binding NextCommand}" MinWidth="48" Height="32"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource IconChevronRight}" Width="14" Height="14"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding DayHeaders}" Margin="64,0,0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="14"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ., StringFormat={}{0:ddd}}" FontSize="10"
                                   Foreground="{DynamicResource TextLowBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ., StringFormat={}{0:dd}}"
                                   Foreground="{DynamicResource TextMidBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="64,*" Height="32" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Room.Number}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextHighBrush}"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="14" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="4"/>
                                <ItemsControl ItemsSource="{Binding Cells}" Grid.ColumnSpan="14">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="14"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="cell" Margin="1" CornerRadius="3"
                                                    PointerPressed="OnCellPointerPressed"
                                                    PointerMoved="OnCellPointerMoved"
                                                    PointerReleased="OnCellPointerReleased"
                                                    PointerCaptureLost="OnCellPointerCaptureLost"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Classes="rangeSelection" Grid.ColumnSpan="14" IsVisible="False"
                                        IsHitTestVisible="False"
                                        Background="{DynamicResource SelectedNavBrush}" Opacity="0.55"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="3" Margin="1"/>
                                <ItemsControl ItemsSource="{Binding Bars}" Grid.ColumnSpan="14">
                                    <ItemsControl.Styles>
                                        <Style Selector="ItemsControl > ContentPresenter">
                                            <Setter Property="Grid.Column" Value="{Binding StartColumn}"/>
                                            <Setter Property="Grid.ColumnSpan" Value="{Binding SpanColumns}"/>
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="bar"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="2,0,0,0"
                                                    CornerRadius="3"
                                                    Padding="6,0"
                                                    Margin="1"
                                                    Cursor="Hand"
                                                    PointerPressed="OnBarPointerPressed"
                                                    PointerMoved="OnBarPointerMoved"
                                                    PointerReleased="OnBarPointerReleased"
                                                    PointerCaptureLost="OnBarPointerCaptureLost">
                                                <TextBlock Text="{Binding Reservation.Guest.FullName}" FontSize="11"
                                                           Foreground="{DynamicResource TextHighBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
